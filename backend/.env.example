# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# --- PostgreSQL ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Binance public market stream ---
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/!miniTicker@arr
# Fallback host if the main one is blocked in your region:
# BINANCE_WS_URL=wss://data-stream.binance.vision/ws/!ticker@arr
QUOTE_ASSET=USDT

# --- Persistence tuning ---
PERSIST_INTERVAL_MS=5000
CANDLE_RETENTION_DAYS=90
